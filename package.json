{
  "name": "docs-site",
  "version": "0.1.0",
  "private": true,
  "description": "A reusable Fumadocs documentation site with optional external content",
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/fetch-content.mjs",
    "build": "DOCS_DIST_DIR=.next-build next build",
    "start": "DOCS_DIST_DIR=.next-build next start",
    "start:standalone": "node .next-build/standalone/server.js",
    "content": "node scripts/fetch-content.mjs",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cn": "^0.5.0",
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.9",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
